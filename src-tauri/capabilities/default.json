{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window of the Fuji Studio desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:app:default",
    "core:resources:default",
    "core:tray:default",
    "dialog:default",
    "fs:default",
    "http:default",
    "notification:default",
    "shell:default",
    "shell:allow-open",
    "store:default"
  ]
}
